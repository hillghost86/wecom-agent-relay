# systemd 单元：sudo cp wecom-bot.service /etc/systemd/system/ && sudo systemctl daemon-reload
[Unit]
Description=WeCom AI Bot long-connection client
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/wecom-bot
EnvironmentFile=/opt/wecom-bot/.env
ExecStart=/usr/bin/env node index.mjs
Restart=always
RestartSec=5
# 让 node 的 stdout 进 journal
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
