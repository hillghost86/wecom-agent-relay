# 企微后台 → 管理工具 → 智能机器人 → API 模式 → 连接方式「使用长连接」
WECOM_BOT_ID=
WECOM_BOT_SECRET=
# 收到消息后的自动回复；留空则不回复
REPLY_TEXT=已收到
# 消息落盘文件；off 关闭
MSG_LOG=./messages.jsonl

# HTTP API（agent 拉消息用）。只监听本机，HTTPS/域名/对外端口由 nginx、Caddy 或宝塔反代到 127.0.0.1:8788
HTTP_HOST=127.0.0.1
HTTP_PORT=8788
# 必填：openssl rand -hex 32
API_TOKEN=

# 断线自报：重连或重启后把离线时段推给这个 userid；留空不报
ADMIN_USERID=
